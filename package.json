{
  "name": "@seatgeek/next-memcached",
  "version": "0.0.2",
  "description": "Next.js 16 cacheHandlers ('use cache' / Cache Components) implementation backed by memcached, a shared cache for self-hosted multi-node deployments, ElastiCache Serverless ready.",
  "keywords": [
    "next",
    "nextjs",
    "cache",
    "cache-handler",
    "cacheHandlers",
    "use-cache",
    "cache-components",
    "memcached",
    "elasticache",
    "serverless",
    "distributed-cache",
    "isr"
  ],
  "license": "Apache-2.0",
  "author": "SeatGeek",
  "homepage": "https://github.com/seatgeek/next-memcached#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seatgeek/next-memcached.git"
  },
  "bugs": {
    "url": "https://github.com/seatgeek/next-memcached/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@11.22.0",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "cp docs/README.md README.md",
    "postpack": "rm -f README.md",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config e2e/vitest.config.ts",
    "test:e2e:plain": "E2E_MODE=plain MEMCACHED_URI=localhost:11211 pnpm test:e2e",
    "test:e2e:tls": "E2E_MODE=tls MEMCACHED_URI=memcaches://localhost:21211 MEMCACHED_TLS_CA=certs/cacert.pem pnpm test:e2e",
    "test:services:start": "docker compose up -d",
    "test:services:stop": "docker compose down",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check:exports": "publint && attw --pack .",
    "docs": "grip . 6419",
    "changeset": "changeset"
  },
  "dependencies": {
    "memcache": "^1.10.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.9",
    "@changesets/cli": "^3.0.1",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.11",
    "publint": "^0.3.24",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
